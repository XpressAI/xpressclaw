#!/bin/sh

# Git credential-helper protocol adapter. The worker keeps the complete Git
# CLI; xpressclaw only supplies credentials when Git asks for github.com.

operation="${1:-get}"
[ "$operation" = "get" ] || exit 0

host=""
protocol=""
while IFS='=' read -r key value; do
    case "$key" in
        host) host="$value" ;;
        protocol) protocol="$value" ;;
    esac
done

[ "$protocol" = "https" ] || exit 0
case "$host" in
    github.com|github.com:*) ;;
    *) exit 0 ;;
esac

[ -n "${XPRESSCLAW_GITHUB_TOKEN:-}" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$XPRESSCLAW_GITHUB_TOKEN"
