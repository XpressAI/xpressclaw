{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "localhost-image-paste",
  "description": "Allows the desktop UI served from loopback to read a pasted image from the system clipboard.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*"]
  },
  "permissions": [
    "clipboard-manager:allow-read-image",
    "core:image:allow-rgba",
    "core:image:allow-size",
    "core:resources:allow-close"
  ]
}
